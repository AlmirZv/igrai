# === Для Capacitor APK (подключение к бэку по локальной сети) ===
# Замените 192.168.1.100 на IP вашего ПК в локальной сети
# Скопируйте в .env и задайте перед сборкой: npm run build
# VITE_API_URL=http://192.168.1.100:3000/api
# VITE_WS_URL=http://192.168.1.100:3000

# === WebSocket (dev) ===
VITE_WS_URL=http://localhost:3000

# Firebase Configuration (замените на ваши реальные значения)
VITE_FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef1234567890abcdef
