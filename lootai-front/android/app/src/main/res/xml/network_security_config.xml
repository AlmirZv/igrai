<?xml version="1.0" encoding="utf-8"?>
<!-- Разрешить HTTP для локальной сети (бэкенд без SSL) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
